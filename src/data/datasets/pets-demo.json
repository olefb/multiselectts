    "tutorial-warmup": {
      "title": "Tutorial: select marked files",
      "instructions": {
        "en": "Select the three files with a flag:\n1. Click one of them.\n2. Hold Ctrl and click the other two.",
        "nb": "Merk de tre filene med flagg:\n1. Klikk på én av dem.\n2. Hold nede Ctrl og klikk på de to andre."
      },
      "view": "tree",
      "expanded": [
        "Practice"
      ],
      "targets": [
        "Practice/contacts.xlsx",
        "Practice/poster.png",
        "Practice/report_january.docx"
      ]
    },
    "tutorial-range": {
      "title": "Tutorial: select a range, then deselect",
      "instructions": {
        "en": "Select the six files with a flag:\n1. Click the first of them, then hold Shift and click the last.\n2. Hold Ctrl and click each of the two files without a flag between them.",
        "nb": "Merk de seks filene med flagg:\n1. Klikk på den første av dem, hold så nede Shift og klikk på den siste.\n2. Hold nede Ctrl og klikk på hver av de to filene uten flagg mellom dem."
      },
      "view": "tree",
      "expanded": [
        "Practice"
      ],
      "targets": [
        "Practice/agenda.docx",
        "Practice/contacts.xlsx",
        "Practice/logo.png",
        "Practice/newsletter.docx",
        "Practice/poster.png",
        "Practice/price_list.xlsx"
      ]
    },
    "tutorial-search": {
      "title": "Tutorial: search",
      "instructions": {
        "en": "Find signature.png, which is in a subfolder, and select it:\n1. Type **signature** in the search box.\n2. Click signature.png.",
        "nb": "Finn signature.png, som ligger i en undermappe, og merk den:\n1. Skriv **signature** i søkefeltet.\n2. Klikk på signature.png."
      },
      "view": "tree",
      "expanded": [
        "Practice"
      ],
      "targets": [
        "Practice/Archive/signature.png"
      ],
      "markTargets": false,
      "highlight": "searchBox"
    },
    "tutorial-list-view": {
      "title": "Tutorial: list view",
