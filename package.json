{
  "name": "multiselect-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "analysis": "tsx scripts/analysis/extract.ts study-data analysis-out && uv run --project analysis python -m msel_analysis analysis-out",
    "analysis:robots": "tsx scripts/analysis/robots.ts analysis-out/robots/logs && tsx scripts/analysis/extract.ts analysis-out/robots/logs analysis-out/robots && uv run --project analysis python -m msel_analysis analysis-out/robots",
    "screenshots": "tsx scripts/thesis-screenshots.ts",
    "appendices": "tsx scripts/thesis-appendices.ts",
    "test:analysis": "uv run --project analysis pytest -q analysis/tests"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.23",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  }
}
